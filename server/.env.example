# 装了吗 · 服务端配置示例
# 复制为 .env 后填写：cp .env.example .env
# 优先级：进程环境变量 > .env > ~/.claude/settings.json 的 env 字段

# ---- AI 凭证（OpenAI Chat Completions 兼容）----
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-5
LLM_MODEL_FALLBACKS=claude-sonnet-4-5,claude-3-7-sonnet-latest,claude-3-5-sonnet-latest

# 可选：GitHub Token，避免匿名调用 Releases/Tags 接口被限流
GITHUB_TOKEN=

# ---- 服务 ----
HOST=0.0.0.0
PORT=8899

# ---- 管理后台口令 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zhuanglma
